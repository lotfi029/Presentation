# Docker build context ignore file
# Prevents unnecessary files from being included in Docker images

# Dependencies
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Build outputs
dist/
build/
out/

# IDE files
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# Git
.git
.gitignore

# Development files
.env.local
.env.*.local
.env.development

# Documentation
docs/
SETUP.md
DEPLOYMENT.md
CODE_*.md
*.md

# Testing
coverage/
.nyc_output/

# Misc
README.md
LICENSE
.editorconfig
.eslintrc*
eslint.config.js

# CI/CD
.github/
.gitlab-ci.yml
.circleci/

# Temporary files
tmp/
temp/
*.tmp
